<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LaterCE.Pages.ShaderPacksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:LaterCE.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="28,16,28,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="光影包" Style="{StaticResource PageTitleStyle}" />

            <Border Grid.Column="1" Background="#1A0EA472" CornerRadius="4" Padding="8,3"
                    VerticalAlignment="Bottom" Margin="12,0,0,6">
                <TextBlock x:Name="TargetVersionText" Text="未选择实例" FontSize="11"
                           Foreground="{StaticResource AccentBrush}" />
            </Border>

            <TextBlock x:Name="InstancePathText" Grid.Column="2" VerticalAlignment="Bottom"
                       Margin="12,0,12,8" FontSize="11" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource SubtleTextBrush}" />

            <Button Grid.Column="3" Content="打开 shaderpacks 目录" Click="OpenFolder_Click"
                    Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
        </Grid>

        <!--  主体：光影市场 / 已安装光影  -->
        <Pivot x:Name="Tabs" Grid.Row="1" SelectionChanged="Tabs_SelectionChanged">

            <PivotItem Header="光影市场">
                <Grid RowSpacing="10" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  筛选栏  -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="VersionCombo" Width="190" VerticalAlignment="Center"
                                  Header="游戏版本" SelectionChanged="Version_Changed" />

                        <ComboBox x:Name="LoaderCombo" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                  Header="加载器" SelectionChanged="Loader_Changed">
                            <ComboBoxItem Content="全部加载器" Tag="" />
                            <ComboBoxItem Content="Iris" Tag="iris" />
                            <ComboBoxItem Content="OptiFine" Tag="optifine" />
                            <ComboBoxItem Content="Canvas" Tag="canvas" />
                            <ComboBoxItem Content="Vanilla" Tag="vanilla" />
                        </ComboBox>

                        <AutoSuggestBox x:Name="SearchBox" Grid.Column="2" VerticalAlignment="Bottom"
                                        PlaceholderText="搜索光影包，例如 Complementary、BSL、Sildur"
                                        QueryIcon="Find" QuerySubmitted="Search_QuerySubmitted" />

                        <Button Grid.Column="3" Content="热门光影" Click="Refresh_Click"
                                Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                    </Grid>

                    <!--  状态栏  -->
                    <StackPanel Grid.Row="1" Spacing="6">
                        <ProgressBar x:Name="StatusBar" IsIndeterminate="False" Visibility="Visible" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="StatusRing" Width="16" Height="16" IsActive="False" />
                            <TextBlock x:Name="StatusText" Text="正在加载热门光影…" FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  搜索结果  -->
                    <ListView x:Name="ResultList" Grid.Row="2" SelectionMode="None"
                              IsItemClickEnabled="False" Padding="0,0,8,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="pages:ShaderMarketItem">
                                <Border Style="{StaticResource CardStyle}" Padding="14,12">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="48" Height="48" CornerRadius="8"
                                                Background="{StaticResource IconPlaceholderBrush}">
                                            <Grid>
                                                <FontIcon Glyph="&#xE706;" FontSize="18"
                                                          Foreground="{StaticResource SubtleTextBrush}" />
                                                <Image Source="{x:Bind Icon, Mode=OneWay}"
                                                       Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Description}" FontSize="12"
                                                       MaxLines="2" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource SubtleTextBrush}" />
                                            <TextBlock Text="{x:Bind Meta}" FontSize="11"
                                                       Foreground="{StaticResource SubtleTextBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{x:Bind Badge, Mode=OneWay}"
                                                   VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource AccentBrush}" />

                                        <Button Grid.Column="3" Content="下载" Click="Download_Click"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                VerticalAlignment="Center" MinWidth="76" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="已安装光影">
                <Grid RowSpacing="10" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  已安装工具条  -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="InstalledSummary" Text="共 0 个光影包" FontSize="13" />
                            <TextBlock Text="禁用会把文件名改为 .disabled，游戏将不再加载；删除会移入回收站。"
                                       FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                        </StackPanel>

                        <AutoSuggestBox x:Name="InstalledSearch" Grid.Column="1" Width="220"
                                        VerticalAlignment="Center" PlaceholderText="筛选光影包名称"
                                        QueryIcon="Find" TextChanged="InstalledSearch_TextChanged" />

                        <Button Grid.Column="2" Content="全部启用" Click="EnableAll_Click"
                                Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />

                        <Button Grid.Column="3" Content="刷新" Click="RefreshInstalled_Click"
                                Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListView x:Name="InstalledList" SelectionMode="None" Padding="0,0,8,0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="pages:InstalledShaderItem">
                                    <Border Style="{StaticResource CardStyle}" Padding="14,12">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="40" Height="40" CornerRadius="8"
                                                    Background="{StaticResource IconPlaceholderBrush}">
                                                <FontIcon Glyph="&#xE706;" FontSize="16"
                                                          Foreground="{StaticResource SubtleTextBrush}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayName}" FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind SizeText}" FontSize="11"
                                                           Foreground="{StaticResource SubtleTextBrush}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{x:Bind StateText, Mode=OneWay}"
                                                       VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{x:Bind StatusBrush, Mode=OneWay}" />

                                            <Button Grid.Column="3" Content="{x:Bind ToggleText, Mode=OneWay}"
                                                    Click="ToggleShader_Click"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    VerticalAlignment="Center" MinWidth="70" />

                                            <Button Grid.Column="4" Content="删除" Click="DeleteShader_Click"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    VerticalAlignment="Center" MinWidth="70" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="EmptyInstalledText" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   Text="当前实例的 shaderpacks 目录里还没有光影包。" />
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>

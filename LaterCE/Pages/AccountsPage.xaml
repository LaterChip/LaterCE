<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LaterCE.Pages.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LaterCE.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="28,16,28,28" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="920" Spacing="14">

            <TextBlock Text="账户" Style="{StaticResource PageTitleStyle}" />

            <!--  当前账户  -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="58" Height="58" CornerRadius="29" Background="#FFE6F5EE">
                        <TextBlock x:Name="CurrentInitial" Text="?" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentName" Text="未登录" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentType" Text="登录后才能加入正版服务器，离线账户仅能进入离线服务器"
                                   Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  添加账户  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="添加账户" Style="{StaticResource SectionTitleStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="微软正版登录" Style="{StaticResource PrimaryButtonStyle}"
                                Click="MsLogin_Click" />
                        <Button Content="LittleSkin 外置登录" Style="{StaticResource GhostButtonStyle}"
                                Click="ToggleLittleSkin_Click" />
                        <Button Content="离线账户" Style="{StaticResource GhostButtonStyle}"
                                Click="ToggleOffline_Click" />
                    </StackPanel>

                    <!--  微软设备码  -->
                    <StackPanel x:Name="MsPanel" Spacing="8" Visibility="Collapsed">
                        <Border Background="#FFF0F4F7" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="在浏览器中打开下面的网址，输入设备代码完成授权"
                                           Style="{StaticResource CaptionStyle}" />

                                <TextBlock x:Name="MsCode" FontSize="28" FontFamily="Consolas" FontWeight="Bold"
                                           Text="------" IsTextSelectionEnabled="True" />

                                <TextBlock x:Name="MsUri" Style="{StaticResource CaptionStyle}"
                                           Text="https://microsoft.com/link" IsTextSelectionEnabled="True" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="打开登录页" Style="{StaticResource GhostButtonStyle}"
                                            Padding="10,5" FontSize="12" Click="OpenMsPage_Click" />
                                    <Button Content="复制代码" Style="{StaticResource GhostButtonStyle}"
                                            Padding="10,5" FontSize="12" Click="CopyCode_Click" />
                                    <Button Content="取消登录" Style="{StaticResource GhostButtonStyle}"
                                            Padding="10,5" FontSize="12" Click="CancelMs_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="MsRing" Width="16" Height="16" IsActive="False"
                                          Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="MsStatus" Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!--  LittleSkin  -->
                    <StackPanel x:Name="LsPanel" Spacing="8" Visibility="Collapsed" MaxWidth="400"
                                HorizontalAlignment="Left">
                        <TextBox x:Name="LsUser" Header="LittleSkin 邮箱" PlaceholderText="you@example.com" />
                        <PasswordBox x:Name="LsPass" Header="密码" />
                        <Button Content="登录 LittleSkin" Style="{StaticResource PrimaryButtonStyle}"
                                Click="LsLogin_Click" />
                        <TextBlock x:Name="LsStatus" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  离线  -->
                    <StackPanel x:Name="OfflinePanel" Spacing="8" Visibility="Collapsed" MaxWidth="400"
                                HorizontalAlignment="Left">
                        <TextBox x:Name="OfflineName" Header="玩家名"
                                 PlaceholderText="3-16 位字母、数字或下划线" />
                        <Button Content="创建离线账户" Style="{StaticResource PrimaryButtonStyle}"
                                Click="CreateOffline_Click" />
                        <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                   Text="离线账户无需联网，但无法进入正版验证服务器。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  账户列表  -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="全部账户" Style="{StaticResource SectionTitleStyle}"
                               Margin="18,16,18,8" />

                    <ListView x:Name="AccountList" Grid.Row="1" SelectionMode="None" Margin="0,0,0,6">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="8,0,8,4" />
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Account">
                                <Grid Padding="12,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="38" Height="38" CornerRadius="19" Background="#FFEDF2F7">
                                        <FontIcon Glyph="&#xE77B;" FontSize="15"
                                                  Foreground="{StaticResource AccentBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Content="设为当前" Style="{StaticResource GhostButtonStyle}"
                                                Padding="12,5" FontSize="12" Click="SetActive_Click" />
                                        <Button Content="移除" Style="{StaticResource GhostButtonStyle}"
                                                Padding="12,5" FontSize="12" Click="Remove_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

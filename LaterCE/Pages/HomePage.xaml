<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LaterCE.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="28,16,28,28" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch" Spacing="16">

            <!--  主视觉  -->
            <Border Background="{StaticResource HeroGradientBrush}" CornerRadius="16" Padding="30,26"
                    BorderThickness="1" BorderBrush="{StaticResource DividerBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="Later CE" FontSize="36" FontWeight="Bold" />
                        <TextBlock x:Name="HeroSubtitle" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   Text="Minecraft Java 版 · 版本管理 / 模组市场 / 多账号登录" />

                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                            <ComboBox x:Name="VersionCombo" Width="280" Height="34"
                                      PlaceholderText="选择已安装的版本"
                                      SelectionChanged="VersionCombo_SelectionChanged" />
                            <Button Content="刷新" Style="{StaticResource GhostButtonStyle}" Click="Refresh_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" MinWidth="180">
                        <Button Content="启动游戏" Height="52" FontSize="16" MinWidth="180"
                                Style="{StaticResource PrimaryButtonStyle}" Click="Launch_Click" />
                        <TextBlock x:Name="HeroAccount" Text="未登录" FontSize="12"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  统计  -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="已安装版本" Style="{StaticResource CaptionStyle}" />
                        <TextBlock x:Name="VersionCountText" Text="0" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionHintText" Text="尚未下载任何版本" Style="{StaticResource CaptionStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Java 运行时" Style="{StaticResource CaptionStyle}" />
                        <TextBlock x:Name="JavaCountText" Text="0" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="JavaHintText" Text="未检测到 Java" Style="{StaticResource CaptionStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="当前版本模组" Style="{StaticResource CaptionStyle}" />
                        <TextBlock x:Name="ModCountText" Text="0" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="ModHintText" Text="—" Style="{StaticResource CaptionStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="当前版本光影" Style="{StaticResource CaptionStyle}" />
                        <TextBlock x:Name="ShaderCountText" Text="0" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="ShaderHintText" Text="尚未安装光影" Style="{StaticResource CaptionStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  运行日志  -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="16,14,16,10">
                        <TextBlock Text="运行日志" Style="{StaticResource SectionTitleStyle}" />
                        <Button Content="打开日志目录" HorizontalAlignment="Right" FontSize="12"
                                Style="{StaticResource GhostButtonStyle}" Padding="10,5" Click="OpenLogs_Click" />
                    </Grid>

                    <ScrollViewer x:Name="LogScroll" Grid.Row="1" Height="230" Padding="16,0,16,14"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True"
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="等待操作…" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

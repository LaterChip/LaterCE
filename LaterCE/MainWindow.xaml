<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LaterCE.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  自定义标题栏  -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Image Width="26" Height="26" VerticalAlignment="Center"
                       Source="ms-appx:///Assets/AppIcon_44.png" Stretch="Uniform" />
                <TextBlock Text="Later CE" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="Minecraft Java 版启动器" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="216"
            SelectionChanged="Nav_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="主页" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="版本管理" Tag="versions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="模组市场" Tag="mods">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA86;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="资源包" Tag="resourcepacks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="整合包" Tag="modpacks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="账户" Tag="accounts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Padding="12,8,12,18" Spacing="10">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12,10"
                            BorderThickness="1" BorderBrush="{StaticResource DividerBrush}">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="FooterAccountName" Text="未登录" FontSize="13"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FooterAccountType" Text="点击前往账户页" FontSize="11"
                                       Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="LaunchButton" Content="启动游戏" HorizontalAlignment="Stretch" Height="44"
                            Style="{StaticResource PrimaryButtonStyle}" Click="LaunchButton_Click" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
